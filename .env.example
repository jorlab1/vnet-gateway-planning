# Copy this file to .env and fill in the values, or set the same names as
# Windows user-level / machine-level environment variables instead.
#
# .env is optional. Values already present in the running process win, so an
# existing environment variable works without creating this file.
#
# Never commit .env or paste the secret value into source, config, or logs.

# Authentication mode: ServicePrincipal (default), DeviceCode, or AzureCli.
# The two user modes need no secret and no client ID.
# POWERBI_AUTH_MODE=ServicePrincipal

POWERBI_TENANT_ID=00000000-0000-0000-0000-000000000000
POWERBI_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Option 1: put the secret here (keep this file local and protected).
POWERBI_CLIENT_SECRET=

# Option 2: leave POWERBI_CLIENT_SECRET empty and point at the environment
# variable that already holds the secret, so no secret is stored in this file.
# POWERBI_CLIENT_SECRET_VARIABLE=FABRIC_TEST_SP_SECRET
